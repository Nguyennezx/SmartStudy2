<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:text="@string/subject_subtitle"
        android:textColor="@color/header_icon"
        android:textSize="14sp" />

    <Button
        android:id="@+id/subject_manage_semesters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:text="@string/semester_manage"
        android:textColor="@color/PeriwinkleBlue"
        style="@style/Widget.Material3.Button.TextButton" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:text="@string/semester_filter_label"
        android:labelFor="@id/subject_semester_filter"
        android:textColor="@color/header_icon" />

    <Spinner
        android:id="@+id/subject_semester_filter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginHorizontal="16dp"
        android:saveEnabled="false" />

    <CheckBox
        android:id="@+id/subject_archived_filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:text="@string/subject_show_archived"
        android:textColor="@color/header_icon"
        android:buttonTint="@color/PeriwinkleBlue" />

    <TextView
        android:id="@+id/subject_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:gravity="center"
        android:textColor="@color/header_icon"
        android:textSize="16sp"
        android:accessibilityLiveRegion="polite" />

</LinearLayout>
