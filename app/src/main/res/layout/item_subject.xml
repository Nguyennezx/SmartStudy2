<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="88dp"
    android:padding="14dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_subject_card">

    <View
        android:id="@+id/subject_color"
        android:layout_width="8dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_subject_color"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/subject_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/header_title"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subject_teacher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:drawableStart="@drawable/ic_subject_teacher"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:textColor="@color/header_icon"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/subject_semester"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:drawableStart="@drawable/ic_subject_semester"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_subject_semester_badge"
            android:textColor="@color/header_icon"
            android:textSize="13sp" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="›"
        android:textSize="28sp"
        android:textColor="@color/header_icon"
        android:importantForAccessibility="no" />

</LinearLayout>
