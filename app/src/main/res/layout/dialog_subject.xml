<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@color/white">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/subject_name_label"
            android:labelFor="@id/subject_input_name"
            android:textColor="@color/header_title" />

        <EditText
            android:id="@+id/subject_input_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="@string/subject_name_hint"
            android:inputType="textCapSentences"
            android:imeOptions="actionNext"
            android:textColor="@color/header_title"
            android:textColorHint="@color/header_icon"
            android:backgroundTint="@color/PeriwinkleBlue" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/subject_teacher_label"
            android:labelFor="@id/subject_input_teacher"
            android:textColor="@color/header_title" />

        <EditText
            android:id="@+id/subject_input_teacher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="@string/subject_teacher_hint"
            android:inputType="textPersonName"
            android:imeOptions="actionDone"
            android:textColor="@color/header_title"
            android:textColorHint="@color/header_icon"
            android:backgroundTint="@color/PeriwinkleBlue" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/subject_color_label"
            android:labelFor="@id/subject_input_color"
            android:textColor="@color/header_title" />

        <Spinner
            android:id="@+id/subject_input_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <View
            android:id="@+id/subject_color_preview"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:background="@drawable/bg_subject_color"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/semester_optional"
            android:labelFor="@id/subject_input_semester"
            android:textColor="@color/header_title" />

        <Spinner
            android:id="@+id/subject_input_semester"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/semester_form_hint"
            android:textSize="12sp"
            android:textColor="@color/header_icon" />

    </LinearLayout>

</ScrollView>
