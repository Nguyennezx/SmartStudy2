<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_weight="1"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:orientation="vertical"
    android:gravity="center"
    android:clickable="true"
    android:focusable="true"
    android:importantForAccessibility="yes">

    <LinearLayout
        android:id="@+id/calendar_chip_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:paddingVertical="4dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_calendar_choice">

        <TextView
            android:id="@+id/calendar_chip_weekday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:includeFontPadding="false"
            android:textColor="@color/header_icon"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/calendar_chip_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="16sp"
            android:includeFontPadding="false"
            android:textStyle="bold"
            android:textColor="@color/header_title"
            android:importantForAccessibility="no" />

    </LinearLayout>

    <TextView
        android:id="@+id/calendar_chip_today"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/calendar_today"
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="@color/PeriwinkleBlue"
        android:importantForAccessibility="no" />

</LinearLayout>
