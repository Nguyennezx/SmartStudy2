<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/semester_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/semester_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_subject_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/subject_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/semester_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/header_title" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:text="@string/semester_subtitle"
        android:textColor="@color/header_icon"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/semester_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:gravity="center"
        android:textColor="@color/header_icon"
        android:textSize="16sp"
        android:accessibilityLiveRegion="polite" />

    <ListView
        android:id="@+id/semester_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp" />

    <Button
        android:id="@+id/semester_add"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:minHeight="52dp"
        android:text="@string/semester_add"
        android:backgroundTint="@color/PeriwinkleBlue"
        android:textColor="@color/white" />

</LinearLayout>
