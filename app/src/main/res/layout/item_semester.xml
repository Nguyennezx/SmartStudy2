<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:minHeight="88dp"
    android:background="@drawable/bg_subject_card">

    <TextView
        android:id="@+id/semester_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/header_title"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/semester_dates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/header_icon"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/semester_archived"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/semester_archived"
        android:textColor="@color/header_icon"
        android:textSize="13sp" />

</LinearLayout>
