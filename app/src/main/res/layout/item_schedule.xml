<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:background="@drawable/bg_subject_card">

    <View
        android:id="@+id/schedule_item_color"
        android:layout_width="8dp"
        android:layout_height="80dp"
        android:background="@drawable/bg_subject_color"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/schedule_item_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/header_title"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/schedule_item_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/header_icon"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/schedule_item_dates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/header_icon"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/schedule_item_room"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/header_icon"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/schedule_item_zone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/header_icon"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
