<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/nav_schedule"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/header_title" />

        <TextView
            android:id="@+id/schedule_add"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="@string/calendar_plus"
            android:textSize="28sp"
            android:gravity="center"
            android:textColor="@color/white"
            android:background="@drawable/bg_calendar_selected"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/schedule_add"
            android:tooltipText="@string/schedule_add" />

        <TextView
            android:id="@+id/calendar_more"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="@string/calendar_more_symbol"
            android:textSize="26sp"
            android:textColor="@color/header_icon"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/calendar_more_label"
            android:tooltipText="@string/calendar_more_label" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/reminder_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/bg_calendar_outline"
                android:visibility="gone">

                <TextView
                    android:id="@+id/reminder_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/header_icon"
                    android:textSize="14sp"
                    android:accessibilityLiveRegion="polite" />

                <TextView
                    android:id="@+id/reminder_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:textColor="@color/PeriwinkleBlue"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="16dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:background="@drawable/bg_calendar_outline">

                    <TextView
                        android:id="@+id/calendar_mode_day"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:text="@string/calendar_day"
                        android:textColor="@color/header_icon"
                        android:textSize="15sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_weight="1"
                        android:background="@drawable/bg_calendar_segment" />

                    <TextView
                        android:id="@+id/calendar_mode_week"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:text="@string/calendar_week"
                        android:textColor="@color/header_icon"
                        android:textSize="15sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_weight="1"
                        android:background="@drawable/bg_calendar_segment" />

                </LinearLayout>

                <TextView
                    android:id="@+id/calendar_today"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="@string/calendar_today"
                    android:textColor="@color/PeriwinkleBlue"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_calendar_today_action"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/calendar_previous"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="@string/calendar_previous_symbol"
                    android:textSize="28sp"
                    android:gravity="center"
                    android:textColor="@color/header_icon"
                    android:background="@drawable/bg_calendar_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/calendar_previous_week" />

                <TextView
                    android:id="@+id/calendar_week_range"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/header_title"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/calendar_choose_date" />

                <TextView
                    android:id="@+id/calendar_next"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="@string/calendar_next_symbol"
                    android:textSize="28sp"
                    android:gravity="center"
                    android:textColor="@color/header_icon"
                    android:background="@drawable/bg_calendar_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/calendar_next_week" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/calendar_days"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:baselineAligned="false" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:background="@color/header_avatar_background" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/calendar_summary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/header_title"
                    android:textStyle="bold"
                    android:accessibilityLiveRegion="polite" />

                <TextView
                    android:id="@+id/calendar_zone"
                    android:layout_width="wrap_content"
                    android:maxWidth="160dp"
                    android:gravity="end"
                    android:layout_marginStart="8dp"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/header_icon" />

            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/calendar_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:visibility="gone">

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/anhptithcm"
                    android:scaleType="centerCrop"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:importantForAccessibility="no" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/bg_calendar_campus_fade"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <ImageView
                        android:layout_width="88dp"
                        android:layout_height="80dp"
                        android:src="@drawable/ic_calendar_empty"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/calendar_empty_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/header_title" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/calendar_empty_hint"
                        android:textSize="14sp"
                        android:textColor="@color/header_icon" />

                    <TextView
                        android:id="@+id/calendar_empty_add"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginTop="24dp"
                        android:paddingHorizontal="24dp"
                        android:paddingVertical="12dp"
                        android:gravity="center"
                        android:background="@drawable/bg_calendar_selected"
                        android:text="@string/calendar_add_action"
                        android:textSize="16sp"
                        android:textColor="@color/white"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/schedule_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp"
                android:textSize="16sp"
                android:textColor="@color/header_icon"
                android:gravity="center"
                android:visibility="gone"
                android:accessibilityLiveRegion="polite" />

            <HorizontalScrollView
                android:id="@+id/calendar_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:layout_marginTop="12dp"
                android:scrollbars="horizontal">

                <com.example.smartstudy.schedule.ui.ScheduleTimelineView
                    android:id="@+id/schedule_timeline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </HorizontalScrollView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
